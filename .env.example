# Postgres with the pgvector extension (see docker-compose.yml)
DATABASE_URL=postgres://cite:cite@localhost:5432/cite

# Optional. Without it, the demo questions are answered from recorded
# fixtures and any other question returns the retrieved passages only.
ANTHROPIC_API_KEY=

# Where the embedding model is cached. Defaults to ~/.cache/cite-models.
# CITE_MODEL_CACHE=

# Set to the number of proxies that append to X-Forwarded-For (usually 1).
# Unset: the per-client limit is shared by every request.
TRUST_PROXY=
